
{
  "name": "ds-headbot",
  "version": "0.3.4",
  "description": "DSH plugin for DSH + ds-bot instance management and audited team communication.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ds-bot",
    "multi-team",
    "manager",
    "team-communication",
    "audit"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./team": "./lib/team-plugin.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "index.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "deploy/Caddyfile",
    "docs/*.md",
    "scripts/*.mjs"
  ],
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
